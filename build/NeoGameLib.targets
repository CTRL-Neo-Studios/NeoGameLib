<Project>

  <PropertyGroup>
    <NeoSchemaOnBuild Condition="'$(NeoSchemaOnBuild)' == ''">true</NeoSchemaOnBuild>
    <!-- the game project directory; the tool creates/updates Data/ under it -->
    <NeoProjectDir Condition="'$(NeoProjectDir)' == ''">$(MSBuildProjectDirectory)</NeoProjectDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- maps, prefab libraries and UI documents are data, not content pipeline assets: copy them next to the build output -->
    <None Remove="Data/NeoMaps/**" />
    <None Remove="Data/NeoPrefabs/**" />
    <None Remove="Data/NeoUI/**" />
    <Content Include="Data/NeoMaps/**;Data/NeoPrefabs/**;Data/NeoUI/**" CopyToOutputDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>

  <Target Name="NeoGenerateSchema" AfterTargets="Build"
          Condition="'$(NeoSchemaOnBuild)' == 'true' and '$(OutputType)' != 'Library' and '$(TargetPath)' != ''">
    <PropertyGroup>
      <_NeoSchemaTool>$(MSBuildThisFileDirectory)..\tools\neo-schema.dll</_NeoSchemaTool>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(_NeoSchemaTool)&quot; &quot;$(TargetPath)&quot; &quot;$(NeoProjectDir)&quot;" />
    <!-- the schema tool writes Data/<Game>.neoui.xsd; the NeoUI folder is created by ExportProject, so documents are included in builds -->
  </Target>

</Project>
