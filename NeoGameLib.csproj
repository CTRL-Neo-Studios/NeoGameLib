<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    
    <PackageId>NeoGameLib</PackageId>
    <Version>0.4.4</Version>
    <Authors>Type-32</Authors>
    <Company>CTRL Neo Studios</Company>
    <Description>NeoGameLib: prefab framework for monogame that packs a lot of punch, with not-so-simple collision bus, render bus, architectural stuff, UI stuff, etc.</Description>
    <PackageTags>monogame;gamedev;framework</PackageTags>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/CTRL-Neo-Studios/NeoGameLib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS8632</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="checks/**/*.cs" />
    <Compile Remove="samples/**/*.cs" />
    <Compile Remove="tools/**/*.cs" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Remove="build/NeoGameLib.targets" />
    <None Include="build/NeoGameLib.targets" Pack="true" PackagePath="build/NeoGameLib.targets" />
  </ItemGroup>

  <!-- publishes & bundles the schema tool -->
  <Target Name="PackSchemaTool" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_SchemaToolPublishDir>$(BaseIntermediateOutputPath)schema-tool</_SchemaToolPublishDir>
    </PropertyGroup>
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/tools/NeoGameLib.SchemaTool/NeoGameLib.SchemaTool.csproj&quot; -c $(Configuration) -o &quot;$(_SchemaToolPublishDir)&quot; --nologo -v q" />
    <ItemGroup>
      <None Include="$(_SchemaToolPublishDir)/**" Pack="true" PackagePath="tools/" Visible="false" />
    </ItemGroup>
  </Target>
</Project>